{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f scripts/hooks/session-start.sh || bash scripts/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f scripts/hooks/session-end.sh || bash scripts/hooks/session-end.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f scripts/hooks/prompt-reminder.sh || bash scripts/hooks/prompt-reminder.sh"
          }
        ]
      }
    ]
  }
}
